/target
/.runs
# Named run roots are used by CI/local smoke isolation too; every run contains
# copied trial workspaces and immutable reports, never source artifacts.
/.runs-*

# Your real backend config (endpoints/models); keep secrets in env vars.
backends.json

# Trial runs build fixtures in place; their lockfiles are run artifacts.
# evals/Cargo.lock itself IS tracked (binary project, reproducible CI).
tasks/*/fixture/Cargo.lock
tasks/*/fixture/target/
