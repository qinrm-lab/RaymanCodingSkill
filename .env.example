# 环境变量配置示例
# 复制此文件为 .env 并填入你的 API Keys

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# RaymanCodingSkill Web API access key
RAYMAN_API_KEY=replace_with_a_strong_local_api_key

# Optional: comma-separated CORS allowlist for the Web API
# RAYMAN_API_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Optional: enable request text previews in API logs. Off by default to avoid logging code/secrets.
# RAYMAN_API_LOG_PREVIEW=false

# 第三方小众模型 API Key（手工填写）
THIRD_PARTY_A_API_KEY=your_third_party_a_key_here
THIRD_PARTY_B_API_KEY=your_third_party_b_key_here

# 可选：自定义 API 端点
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# 第三方模型 endpoint 在 config/default_config.yaml 的 models.thirdparty_a/base_url
# 和 models.thirdparty_b/base_url 中修改；模型名在 model_routing.routes 中修改。

# 可选：本地模型配置
# LOCAL_MODEL_URL=http://localhost:11434
