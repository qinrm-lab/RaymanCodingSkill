# 环境变量配置示例
# 复制此文件为 .env 并填入你的 API Keys

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# RaymanCodingSkill Web API access key（RAYMAN_API_TOKEN 是等效别名，二选一即可）
RAYMAN_API_KEY=replace_with_a_strong_local_api_key
# RAYMAN_API_TOKEN=replace_with_a_strong_local_api_key

# Optional: comma-separated CORS allowlist for the Web API
# RAYMAN_API_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# 第三方小众模型 API Key（手工填写）
THIRD_PARTY_A_API_KEY=your_third_party_a_key_here
THIRD_PARTY_B_API_KEY=your_third_party_b_key_here

# 自定义 API 端点：任意 provider 都支持 {PROVIDER}_BASE_URL 环境变量覆盖
# （provider 名大写、非字母数字转下划线）。环境变量优先级高于 config/*.yaml，
# 且属于机器级配置、不会被写回仓库，是把私有端点移出 tracked 配置的首选方式。
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# THIRDPARTY_A_BASE_URL=https://your-proxy.example/openai
# THIRDPARTY_B_BASE_URL=https://your-endpoint.example/v1
# LOCAL_BASE_URL=http://localhost:11434

# 密钥外泄防护：openai/anthropic 的密钥默认只发往官方主机。若你合法地经自建代理访问它们，
# 用上面的 {PROVIDER}_BASE_URL 覆盖，或把可信主机后缀加入下面的允许列表（逗号分隔）。
# RAYMAN_ALLOWED_KEY_HOSTS=proxy.internal.example,gateway.mycorp.example

# 把私有端点/局域网地址等敏感值放进 gitignore 的本地覆盖文件，避免提交进仓库：
#   config/*.local.yaml（例如 config/auxiliary_ai.local.yaml），或直接用上面的环境变量。
